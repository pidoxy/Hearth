# ── Required in production ─────────────────────────────────────────
# Public URL of the app (used in emails, invite and calendar links)
APP_URL=https://hearth.example.com

# Anthropic API key — enables reading photos & PDFs and much better extraction.
# Without it Hearth falls back to an offline text-only date parser.
ANTHROPIC_API_KEY=
# Optional model override (default: claude-opus-5-5)
# HEARTH_MODEL=claude-opus-5-5

# ── Forwarding email (optional but recommended) ────────────────────
# Domain whose MX points at your inbound provider (e.g. Postmark inbound).
INBOUND_DOMAIN=in.hearth.example.com
# Shared secret; configure the provider webhook as
#   https://hearth.example.com/api/inbound/postmark?secret=<INBOUND_SECRET>
INBOUND_SECRET=change-me-long-random-string

# ── Reminder emails (optional) ─────────────────────────────────────
# Any SMTP provider. Without it, reminders are written to the server log.
SMTP_URL=smtps://user:pass@smtp.example.com:465
MAIL_FROM="Hearth <hearth@hearth.example.com>"
# Hours (household local time) for the digest and night-before reminders.
DIGEST_HOUR=7
PREP_HOUR=19
# Reminders run in-process every 15 min. To use an external cron instead, set
# DISABLE_SCHEDULER=true and call POST /api/cron/reminders with
# "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=change-me-too
# DISABLE_SCHEDULER=true

# ── Storage ────────────────────────────────────────────────────────
# Directory for the SQLite database and uploads (mount a volume here).
DATA_DIR=./data
# Max captures per household per hour (caps API spend)
CAPTURES_PER_HOUR=60
